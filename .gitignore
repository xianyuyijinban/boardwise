.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# Reference material cloned for reading only (official EasyEDA Pro format
# docs). Never part of the package.
.ref/

# Connector build artifacts: reproducible from source via `npm run package`,
# so committing them would only create a chance for the two to disagree.
connector/node_modules/
connector/dist/
connector/*.eext

# dsh plugin (045): the pack tarball is reproducible and stays out of git, but
# lib/ IS tracked since 0.1.2 — DSH STORE's fixed-commit automation reads the
# git tree, never runs `prepare`/`build`, and blocks the listing when the
# runtime files declared in `files` are not committed.
dsh-plugin/node_modules/
dsh-plugin/*.tgz

# Rust contract workspace (540C): Cargo output is reproducible from the locked sources.
rust/target/

# PyInstaller's output for the single-file friend build (028 batch 3a). The
# artifact is a release attachment, not a source file: `packaging/build_exe.py`
# rebuilds it byte-for-byte from the sources plus the connector bundle.
packaging/build/
packaging/out/
packaging/*.spec.bak

# Root-level probe/debug scratch from live troubleshooting sessions. Evidence
# worth keeping lives in evidence/; these were one-shot dumps.
.probe_*.json
.tmp_*
draw_*.txt
g2.json
rb.json
.easyeda/
.workbuddy-memory-tmp

# An embedded git repository (has its own .git). Held out of the outer
# history until the owner decides whether to merge contents or keep it
# standalone — a gitlink entry would only pretend to be recoverable.
inputs/smart_pillbox/firmware/

# Live-session evidence and output scratch. Both default to local-only:
# existing tracked files stay tracked, and a new acceptance artifact enters git
# only after explicit review/approval (the mechanical add is `git add -f`).
# Untracked evidence is NOT a deletion candidate merely because it is ignored.
# See docs/workspace-conventions.md (540A).
evidence/
outputs/

# Local private-source drop box (2026-10-15 history scrub). These are real
# boards — mostly company designs — read as input by `tools/harvest_parts.py`
# and by the tests that read them; they are never an artifact of this
# repository. The four files that used to live here were removed from git's
# whole history, so keep your own copies in this directory: with them present,
# `harvest_parts.py --check` and the source-reading tests work as before, and
# neither this rule nor `tools/check_repo_hygiene.py` has anything to report.
blocklib/sources/

# The sensitive-word list (186 §D): one word per line, read by
# `tools/check_repo_hygiene.py`'s second gate. It is the *owner's* list of names
# that must not appear in this repository, so the file itself never enters it —
# with the file present on your machine the gate scans every tracked file for
# those words; without it (every clone, every CI run) the gate is off.
.sensitive-words
